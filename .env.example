# ── Copy to .env and edit. Consumed by docker compose. ───────────────────────
# Safe-by-default profile: mock EMR, no AI keys, dry-run web submission.

# App profile. "production" locks CORS. With the default same-origin /api proxy
# the browser never makes cross-origin calls, so CORS config is usually unneeded.
APP_ENV=production

# Postgres (internal only). CHANGE the password for any shared/production deploy.
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=ai_assistant
POSTGRES_DB=ai_assistant

# EMR. Mock is safe-by-default (no real PHI source). To connect a real read-only
# EMR, set USE_MOCK_EMR=false and EMR_DATABASE_URL.
USE_MOCK_EMR=true
EMR_DATABASE_URL=

# AI. Empty keys fall back to rule-based / mock behavior.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZSNL4hPqCnqoMPaI4jGX
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.62
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.25
ELEVENLABS_USE_SPEAKER_BOOST=true

# Web-submission egress. "mock" = safe dry-run (no network). Only switch to a real
# driver (e.g. browserless) intentionally — it is PHI egress.
WEB_SUBMIT_DRIVER=mock
BROWSERLESS_URL=

# Workflow state engine. This root file is consumed by Docker Compose, which
# starts Temporal plus a worker. For native backend-only dev, copy backend/.env.example
# instead or set WORKFLOW_ENGINE=local.
WORKFLOW_ENGINE=temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=form-completion
TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=120
TEMPORAL_ACTIVITY_WORKERS=4
TEMPORAL_VERSION=1.25.2
TEMPORAL_UI_VERSION=2.31.2
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_POSTGRES_DB=temporal

# Admin auth. CHANGE ALL THREE before any non-local deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_JWT_SECRET=change-me-in-production

# External EMR pull API for behavioral-health self-report results.
# Comma-separated keys. Empty disables /api/clinical/results reads.
CLINICAL_RESULTS_API_KEYS=

# CORS. Only needed for a split-domain setup (frontend and backend on different
# public origins). Leave empty when using the default same-origin /api proxy.
CORS_ALLOWED_ORIGINS=

# ── Frontend → backend wiring ────────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_BASE_URL empty to use the same-origin /api proxy: the
# browser calls the frontend origin and Next forwards to BACKEND_INTERNAL_URL.
# For a split-domain setup, set it to the PUBLIC backend URL (https://api.example.com).
NEXT_PUBLIC_API_BASE_URL=
BACKEND_INTERNAL_URL=http://backend:8000

# Host port mappings (mainly for local Docker Desktop).
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5499
