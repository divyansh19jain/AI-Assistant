# Application
APP_ENV=development

# App database (local PostgreSQL via Docker)
APP_DATABASE_URL=postgresql+psycopg://ai_assistant:ai_assistant@127.0.0.1:5499/ai_assistant

# EMR database (read-only, Talbot)
EMR_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@10.1.104.71:5432/talbotdev

# Set to true to use mock EMR data instead of connecting to the real EMR
USE_MOCK_EMR=true

# AI / Voice API keys (leave empty to use rule-based / mock implementations)
# OpenAI powers the conversational assistant (answer extraction, question
# rephrasing, and help/explain) via LangChain. Set this to enable real AI.
OPENAI_API_KEY=
# OpenAI chat model. Kept configurable because model lineups change often.
OPENAI_MODEL=gpt-5.4-mini
# Voice: OpenAI STT/TTS is used when OPENAI_API_KEY is set. ElevenLabs is the
# preferred high-quality TTS path when ELEVENLABS_API_KEY is set.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZSNL4hPqCnqoMPaI4jGX
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.62
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.25
ELEVENLABS_USE_SPEAKER_BOOST=true

# PDF output directory (relative to backend/)
PDF_OUTPUT_DIR=app/pdf/generated_pdfs

# Workflow state engine. Use local for native dev/tests; Docker Compose sets this
# to temporal and runs app.workflows.temporal_worker.
WORKFLOW_ENGINE=local
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=form-completion
TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=120
TEMPORAL_ACTIVITY_WORKERS=4
